# Copy to .env and fill in
VITE_API_URL=http://localhost:4000
VITE_RAZORPAY_KEY_ID=
VITE_GOOGLE_CLIENT_ID=

# Demo mode serves local sample data (no backend/Postgres needed).
# Defaults to true so the repo runs standalone; set false to use the API.
VITE_DEMO_MODE=true

# Falls back to demo data when public GET requests fail (keeps the
# storefront browsable while the API is offline).
VITE_DEMO_FALLBACK=true
